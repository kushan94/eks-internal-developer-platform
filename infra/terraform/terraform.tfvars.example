region        = "eu-north-1"
allowed_cidrs = ["203.0.113.10/32"] # Replace with your own IP
platform_domain    = "idp.example.com" # The same value as the bootstrap stack. The workflows read the IDP_DOMAIN repository variable.
cluster_admin_arns = ["arn:aws:iam::111122223333:role/managed/AccountFullAccessRole"] # The role you use with aws login
